      impact: "24% fewer false positives • 96% faster",
      metrics: [
        "88.3% legal agreement",
        "1,000 videos in 45 minutes",
        "Llama 3 + Mixtral ensemble"
      ],
      tech: ["SBERT", "Llama 3", "FFmpeg", "Acoustic Hashing"],
      color: "from-cyan-500 to-teal-500"
    }
