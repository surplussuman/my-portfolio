import React, { useState, useEffect } from 'react';
import { motion, useScroll, useTransform } from 'framer-motion';
import { 
  Code2, Database, Brain, Cloud, Server, Cpu, 
  Github, Linkedin, Mail, Phone, MapPin, Award,
  ExternalLink, ChevronDown, Menu, X, FileText,
  Briefcase, GraduationCap, Rocket, Zap, Target
} from 'lucide-react';

const Portfolio = () => {
  const [isMenuOpen, setIsMenuOpen] = useState(false);
  const [activeSection, setActiveSection] = useState('home');
  const { scrollYProgress } = useScroll();
  const opacity = useTransform(scrollYProgress, [0, 0.2], [1, 0]);
  const scale = useTransform(scrollYProgress, [0, 0.2], [1, 0.8]);

  // Intersection Observer for active section
  useEffect(() => {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            setActiveSection(entry.target.id);
          }
        });
      },
      { threshold: 0.5 }
    );

    document.querySelectorAll('section[id]').forEach((section) => {
      observer.observe(section);
    });

    return () => observer.disconnect();
  }, []);

  const navigation = [
    { name: 'Home', href: '#home' },
    { name: 'About', href: '#about' },
    { name: 'Experience', href: '#experience' },
    { name: 'Projects', href: '#projects' },
    { name: 'Skills', href: '#skills' },
    { name: 'Contact', href: '#contact' },
  ];

  const skills = {
    "AI & Machine Learning": [
      { name: "GPT-4o / Gemini Pro", icon: Brain },
      { name: "LangChain / LangGraph", icon: Code2 },
      { name: "RAG & Vector DBs", icon: Database },
      { name: "PyTorch / TensorFlow", icon: Cpu },
      { name: "Computer Vision", icon: Target },
      { name: "NLP & Transformers", icon: Brain },
    ],
    "Backend & Infrastructure": [
      { name: "Django REST / FastAPI", icon: Server },
      { name: "Docker / Kubernetes", icon: Cloud },
      { name: "PostgreSQL / MongoDB", icon: Database },
      { name: "Redis / Celery", icon: Server },
      { name: "Nginx / Gunicorn", icon: Server },
      { name: "CI/CD Pipelines", icon: Rocket },
    ],
    "Cloud & DevOps": [
      { name: "AWS (EC2, S3)", icon: Cloud },
      { name: "Prometheus / Grafana", icon: Target },
      { name: "Linux / Ubuntu", icon: Server },
      { name: "WebSockets / WebRTC", icon: Zap },
    ]
  };

  const projects = [
    {
      title: "Cloud Coding Platform",
      role: "Technical Lead",
      impact: "50x capacity increase • 5,000+ concurrent users",
      metrics: [
        "95.7% faster response time (180ms p95)",
        "58.5% cost reduction",
        "99.8% uptime SLA"
      ],
      tech: ["Docker", "Redis", "WebSockets", "Gunicorn"],
      color: "from-purple-500 to-pink-500"
    },
    {
      title: "AI Interview Platform",
      role: "Lead AI Architect",
      impact: "500+ interviews/day • 98.5% cost savings",
      metrics: [
        "75% reduction in time-to-hire",
        "88% candidate engagement",
        "RAG-based resume analysis"
      ],
      tech: ["LangGraph", "Pinecone", "GPT-4o", "Agentic AI"],
      color: "from-blue-500 to-cyan-500"
    },
    {
      title: "AI Video Translation",
      role: "ML Engineer",
      impact: "99% faster processing • 98.3% cost savings",
      metrics: [
        "3 weeks → 4 hours processing",
        "$5,600 → $96 per hour",
        "0.847 BLEU score"
      ],
      tech: ["WhisperAI", "Wav2Lip", "NLLB-200", "FFmpeg"],
      color: "from-violet-500 to-purple-500"
    },
    {
      title: "Smart Exam Evaluation",
      role: "Computer Vision Lead",
      impact: "160+ centers • 600K+ answer sheets",
      metrics: [
        "98.7% accuracy",
        "90% time reduction",
        "93.8% cost savings"
